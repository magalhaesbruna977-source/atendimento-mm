# Copie este arquivo para .env.local e preencha com os valores reais.
# O arquivo .env.local NUNCA deve ser commitado no git (ele já está no .gitignore).

# URL do projeto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública "anon" do Supabase (Project Settings > API)
# Pode ser exposta no navegador — o acesso real é controlado por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service role" do Supabase (Project Settings > API)
# NUNCA exponha esta chave no navegador — use apenas em código de servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Chave da API da Anthropic (Claude), usada para gerar as respostas
ANTHROPIC_API_KEY=

# Chave da API da Voyage AI, usada para gerar embeddings da base de conhecimento
VOYAGE_API_KEY=
